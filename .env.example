# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 .gitignore에 있어 커밋되지 않는다.
# Vercel에 배포할 때는 프로젝트 설정 → Environment Variables에 같은 값을 넣는다.
#
# Supabase 대시보드 → Project Settings → API 에서 확인할 수 있다.

# PUBLIC_ 접두사가 붙은 값은 브라우저 번들에 그대로 들어간다.
# anon key는 원래 공개를 전제로 설계된 키이며, 행 수준 보안(RLS)이
# "남의 데이터는 애초에 보이지 않게" 막아 준다. 그래서 노출되어도 안전하다.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# service_role 키는 RLS를 통째로 우회한다.
# 절대 PUBLIC_ 접두사를 붙이지 말고, 브라우저로 가는 코드에서 참조하지 말 것.
# 지금은 쓰지 않으므로 비워 둔다.
# SUPABASE_SERVICE_ROLE_KEY=

# Phase 6(AI 문제 생성)에서 사용. 서버 라우트에서만 참조한다.
# ANTHROPIC_API_KEY=
