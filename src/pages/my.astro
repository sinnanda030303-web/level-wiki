---
import Base from '../layouts/Base.astro';
import MyWiki from '../components/MyWiki';
import AuthPanel from '../components/AuthPanel';
import { allConcepts, allPhenomena } from '../lib/content';

// 저장소에는 slug만 들어 있으므로 제목·요약·분야는 빌드 타임에 함께 넘긴다.
// 현상도 개념과 같은 방식으로 저장되므로(SaveButton 공용), 여기서 함께
// 실어 보내지 않으면 저장은 되어도 목록에서 조용히 사라진다.
const concepts = [
  ...allConcepts.map((c) => ({
    slug: c.slug,
    title: c.title,
    summary: c.summary,
    field: c.field,
  })),
  ...allPhenomena.map((p) => ({
    slug: p.slug,
    title: p.title,
    summary: p.summary,
    field: 'phenomena',
    isPhenomenon: true,
  })),
];
---

<Base
  title="내 지식 — Level Wiki"
  description="저장한 개념과 마지막으로 읽은 난이도를 모아 봅니다."
  wide
  noindex
>
  <section class="hero my-hero">
    <h1>내 지식</h1>
    <p>저장한 개념과 마지막으로 읽은 난이도가 쌓입니다.</p>
  </section>

  <a class="map-link" href="/map">
    <span>
      <b>지식 지도 보기</b>
      <span>저장한 개념이 분야별 선수 관계 위에서 어디까지 채워졌는지 봅니다.</span>
    </span>
    <span class="map-link-arrow" aria-hidden="true">→</span>
  </a>

  <a class="map-link" href="/quiz">
    <span>
      <b>문제 풀기</b>
      <span>저장한 개념에서 5문항을 뽑아 풀고, 약한 개념을 찾습니다.</span>
    </span>
    <span class="map-link-arrow" aria-hidden="true">→</span>
  </a>

  <!-- 두 컴포넌트 모두 localStorage를 읽으므로 서버에서는 그릴 수 없다 -->
  <AuthPanel client:only="react" />
  <MyWiki client:only="react" concepts={concepts} />

  <p class="my-note">
    로그인하지 않으면 이 기록은 지금 쓰는 브라우저 안에만 남습니다. 기기를 바꾸거나
    브라우저 데이터를 지우면 함께 사라집니다. 로그인하면 계정에 보관되어 다른
    기기에서도 이어 볼 수 있습니다.
  </p>
</Base>
